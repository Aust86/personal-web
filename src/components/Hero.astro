---
import HeroBorder from "./HeroBorder.svg"
import IconsAstroComponent from "./Icons.astro"
---

<HeroBorder id="HeroBorder"/>
<div id="Hero">
    <img src="/PFP.png" alt="Profile Picture"/>
    <div id="details">
        <h1>Frame</h1>
        <p>3D Artist & Not Professional Coder</p>
        <div id="links">
            <a href="https://ko-fi.com/framevfx" target="_blank" aria-label="Ko-Fi"><IconsAstroComponent icon="kofi"/></a>
            <a href="https://www.youtube.com/@frame222c" target="_blank" aria-label="YouTube"><IconsAstroComponent icon="youtube"/></a>
            <a href="https://www.tiktok.com/@frame_cgi" target="_blank" aria-label="TikTok"><IconsAstroComponent icon="tiktok"/></a>
            <a href="https://x.com/Frame222_c" target="_blank" aria-label="Twitter"><IconsAstroComponent icon="twitter"/></a>
            <a href="https://discord.com/users/1535818566878892072" target="_blank" aria-label="Discord"><IconsAstroComponent icon="discord"/></a>
        </div>
    </div>
</div>

<div id="svg-border">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
        <path fill="#110f10" fill-opacity="1" d="M0,64L36.9,288L73.8,192L110.8,192L147.7,192L184.6,288L221.5,160L258.5,96L295.4,288L332.3,96L369.2,64L406.2,32L443.1,96L480,320L516.9,192L553.8,160L590.8,0L627.7,224L664.6,256L701.5,160L738.5,256L775.4,224L812.3,320L849.2,128L886.2,288L923.1,96L960,192L996.9,224L1033.8,224L1070.8,224L1107.7,256L1144.6,64L1181.5,288L1218.5,320L1255.4,288L1292.3,288L1329.2,288L1366.2,320L1403.1,128L1440,64L1440,0L1403.1,0L1366.2,0L1329.2,0L1292.3,0L1255.4,0L1218.5,0L1181.5,0L1144.6,0L1107.7,0L1070.8,0L1033.8,0L996.9,0L960,0L923.1,0L886.2,0L849.2,0L812.3,0L775.4,0L738.5,0L701.5,0L664.6,0L627.7,0L590.8,0L553.8,0L516.9,0L480,0L443.1,0L406.2,0L369.2,0L332.3,0L295.4,0L258.5,0L221.5,0L184.6,0L147.7,0L110.8,0L73.8,0L36.9,0L0,0Z"></path>
    </svg>
</div>

<style>

    #HeroBorder {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100svh;
        pointer-events: none;
    }

    #svg-border {
    position: absolute;
    top: 100svh;
    left: 0;
    width: 100%;
    z-index: 10;
}

#svg-border svg {
    display: block;
    width: 100%;
    height: auto;
}
    
    #Hero {
        background-color: var(--background-color);
        color: white;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
        height: 100svh;
        justify-content: space-between;
        padding: 20%;
        img {
            aspect-ratio: 1 / 1;
            object-fit: cover;
            border-radius: 100%;
            width: 33%;
        }

        #details {
            text-align: right;
            h1 {
                font-size: clamp(3rem, 8vw, 10rem);
                margin: 0;
                -webkit-text-stroke: 1rem var(--primary-color);

                paint-order: stroke fill;
            }
            p {
                font-size: clamp(0.25rem, 4vw, 2rem);
                margin: 0;
            }

            #links {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: clamp(0.4rem, 1.5vw, 1rem);
                width: min(100%, 30rem);
                margin-left: auto;

                a {
                    flex: 1 1 0;
                    min-width: 0;
                    max-width: 4rem;
                    aspect-ratio: 1;
                    border: 0;
                    border-radius: 50%;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    svg {
                        width: 80%;
                        height: 80%
                    }
                    background: rgba(17, 15, 16, 0.8);
                    cursor: pointer;
                    transition:
                        background 0.2s ease,
                        transform 0.2s ease;
                }
                a:hover {
                    background: var(--primary-color);
                }
            }
        }
    }
</style>